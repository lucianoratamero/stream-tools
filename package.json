{
	"name": "bokeh-experiments",
	"version": "1.0.0",
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "vite dev",
		"now_playing": "node nowPlayingSocket.js",
		"local": "pnpm run '/^(dev|now_playing)$/'",
		"build": "vite build",
		"deploy": "git checkout $1 && pnpm run build && gh-pages -d build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"homepage": "http://www.ratamero.com",
	"license": "MIT",
	"devDependencies": {
		"@mdsvex/plugin-anchors": "0.1.0-next.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/dat.gui": "^0.7.13",
		"@types/lodash-es": "^4.17.12",
		"@typescript/native": "npm:typescript@^7.0.2",
		"gh-pages": "^6.3.0",
		"husky": "^9.1.7",
		"mdsvex": "^1.0.0-next.6",
		"prettier": "^3.10.1",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.108.2",
		"svelte-check": "^4.7.8",
		"svelte-confetti": "^2.3.2",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	},
	"type": "module",
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"comfy.js": "^1.1.29",
		"dat.gui": "^0.7.9",
		"iconify-icon": "^3.0.5",
		"lodash-es": "^4.18.1",
		"nice-color-palettes": "^4.0.0",
		"svelte": "^5.58.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tmi.js": "^1.8.5",
		"ws": "^8.23.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
